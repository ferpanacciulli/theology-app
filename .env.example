# Copia este archivo a .env y completa con los datos de tu proyecto de Supabase
# (Project Settings -> API Keys en supabase.com, pestaña "Publishable and secret
# API keys"). El archivo .env no se sube a git.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
